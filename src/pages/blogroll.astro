---
import { getCollection } from "astro:content";

import BaseLayout from "#layouts/BaseLayout.astro";

const blogroll = await getCollection("blogroll");
blogroll.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="thinety - Blogroll">
  <h1 class="mb-4 text-center text-xl">Blogroll</h1>
  <ul class="flex flex-col gap-4">
    {blogroll.map((post) => (
        <li>
          <div class="text-foreground-light">
            {post.data.date.toDateString().split(" ").slice(1).join(" ")}, {new URL(post.data.link).hostname}
          </div>
          <a class="text-primary" href={post.data.link}>
            {post.data.title}
          </a>
        </li>
      ))}
  </ul>
</BaseLayout>
