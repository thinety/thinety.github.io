---
import BaseLayout from "#layouts/BaseLayout.astro";

const articles = [
  {
    title: "Coding Machines",
    link: "https://www.teamten.com/lawrence/writings/coding-machines/",
  },
  {
    title: "The Night Watch",
    link: "https://www.usenix.org/system/files/1311_05-08_mickens.pdf",
  },
  {
    title: "Great Hackers",
    link: "https://paulgraham.com/gh.html",
  },
  {
    title: "Undergraduation",
    link: "https://paulgraham.com/college.html",
  },
  {
    title: "The case of the 500-mile email",
    link: "https://www.ibiblio.org/harris/500milemail.html",
  },
  {
    title: "The log/event processing pipeline you can't have",
    link: "https://apenwarr.ca/log/20190216/the-log-event-processing-pipeline-you-cant-have",
  },
  {
    title: "Generalizing From One Example",
    link: "https://www.lesswrong.com/posts/baTWMegR42PAsH9qJ/generalizing-from-one-example",
  },
  {
    title: "Falling Into The Pit of Success",
    link: "https://blog.codinghorror.com/falling-into-the-pit-of-success/",
  },
  {
    title: "Parse, don’t validate",
    link: "https://lexi-lambda.github.io/blog/2019/11/05/parse-don-t-validate/",
  },
  {
    title: "Notes on structured concurrency, or: Go statement considered harmful",
    link: "https://vorpus.org/blog/notes-on-structured-concurrency-or-go-statement-considered-harmful",
  },
  {
    title: "The Scoped Task trilemma",
    link: "https://without.boats/blog/the-scoped-task-trilemma/",
  },
  {
    title: "Futures Concurrency III: Select!",
    link: "https://blog.yoshuawuyts.com/futures-concurrency-3/",
  },
  {
    title: "Tasks Are the Wrong Abstraction",
    link: "https://blog.yoshuawuyts.com/tasks-are-the-wrong-abstraction/",
  },
  {
    title: "Memory Safety Is a Matter of Life and Death",
    link: "https://joshlf.com/posts/memory-safety-life-and-death/",
  },
  {
    title: "The Future of Everything is Lies, I Guess",
    link: "https://aphyr.com/posts/411-the-future-of-everything-is-lies-i-guess",
  },
  {
    title: "Please stop externalizing your costs directly into my face",
