---
import BaseLayout from "#layouts/BaseLayout.astro";

const articles = [
  {
    title: "Coding Machines",
    link: "https://www.teamten.com/lawrence/writings/coding-machines/",
  },
  {
    title: "The Night Watch",
    link: "https://www.usenix.org/system/files/1311_05-08_mickens.pdf",
  },
  {
    title: "Great Hackers",
    link: "https://paulgraham.com/gh.html",
  },
  {
    title: "Undergraduation",
    link: "https://paulgraham.com/college.html",
  },
  {
    title: "The case of the 500-mile email",
    link: "https://www.ibiblio.org/harris/500milemail.html",
  },
  {
    title: "Falling Into The Pit of Success",
    link: "https://blog.codinghorror.com/falling-into-the-pit-of-success/",
  },
  {
    title: "Parse, don’t validate",
    link: "https://lexi-lambda.github.io/blog/2019/11/05/parse-don-t-validate/",
  },
  {
    title: "Generalizing From One Example",
    link: "https://www.lesswrong.com/posts/baTWMegR42PAsH9qJ/generalizing-from-one-example",
  },
  {
    title: "Something Big Is Happening",
    link: "https://shumer.dev/something-big-is-happening",
  },
];
---

<BaseLayout title="thinety - Links">
  <h1 class="mb-4 text-center text-xl">Links</h1>
  <ul class="flex flex-col gap-4">
    {articles.map((article) => (
        <li>
          <div class="text-primary">{article.title}</div>
          <a class="wrap-break-word ml-4 text-foreground-light" href={article.link}>
            {article.link}
          </a>
        </li>
      ))}
  </ul>
</BaseLayout>
