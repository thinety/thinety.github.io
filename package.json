{
  "name": "thinety-github-io",
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#assets/*": "./src/assets/*",
    "#layouts/*": "./src/layouts/*"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "oxfmt --check && oxlint && astro check",
    "build:cv": "mkdir -p public && typst compile cv.typ public/cv.pdf",
    "build:astro": "astro build",
    "build": "npm run build:cv && npm run build:astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.7",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@astrojs/language-server": "^2.16.11",
    "@tailwindcss/language-server": "^0.14.29",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.3.0",
    "vscode-langservers-extracted": "^4.10.0"
  }
}
